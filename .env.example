# Environment Variable Configuration Blueprint (.env.example)

# MySQL Database Configuration
DB_URL=jdbc:mysql://mysql:3306/skinlesion_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=skinuser
DB_PASSWORD=skinpassword
DB_DRIVER=com.mysql.cj.jdbc.Driver
DB_DIALECT=org.hibernate.dialect.MySQLDialect

# Spring Boot Microservice Gateway URL Configuration
ML_SERVICE_URL=http://skin-ml-service:8000
CHATBOT_SERVICE_URL=http://chatbot-service:8001

# NVIDIA Nemotron AI Model & API Key Configuration
NEMOTRON_SERVICE_URL=https://integrate.api.nvidia.com/v1/chat/completions
NEMOTRON_MODEL=nvidia/llama-3.1-nemotron-70b-instruct
NEMOTRON_API_KEY=your_nvidia_api_key_here
